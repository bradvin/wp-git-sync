{
    "name": "fooplugins/wp-git-sync",
    "description": "WP Git Sync plugin",
    "type": "wordpress-plugin",
    "require": {
        "php": ">=7.4"
    },
    "require-dev": {
        "phpstan/phpstan": "^1.11",
        "szepeviktor/phpstan-wordpress": "^1.3"
    },
    "scripts": {
        "phpstan": "phpstan analyse --level=5 -c vendor/szepeviktor/phpstan-wordpress/extension.neon wp-git-sync.php includes admin --memory-limit=1G --no-progress --debug",
        "phpstan:baseline": "phpstan analyse --level=5 -c vendor/szepeviktor/phpstan-wordpress/extension.neon wp-git-sync.php includes admin --generate-baseline=phpstan-baseline.neon --no-progress --debug"
    }
}
